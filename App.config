<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- 和刻码同一套领码。一次领一对：PACK type=1，客户码 type=2。改地址只改这里 -->
    <add key="GenerateUrl" value="http://newmes.hdc-group.cn/core/bmZeroQrCodeList/generate" />
    <!-- 本机 Windows 打印机名称，必须装好。没有 Argox 就改成设备管理器里的名字 -->
    <add key="PrinterName" value="TSC TTP-244 Pro" />
    <!-- 一张标签的真实尺寸。高度必须对准间隙，20 会让第二张对不齐红灯 -->
    <add key="LabelWidthMm" value="50" />
    <add key="LabelHeightMm" value="40" />
    <add key="LabelGapMm" value="3" />
    <add key="PrintBandMm" value="20" />
    <add key="PackDownMm" value="5" />
    <add key="CustDownMm" value="10" />
    <!-- 扫码打印查库。密码不要提交到 git，本机填好即可 -->
    <add key="DbHost" value="10.101.200.15" />
    <add key="DbPort" value="3306" />
    <add key="DbUser" value="root" />
    <add key="DbPassword" value="" />
    <add key="DbName" value="" />
    <add key="DbTable" value="" />
    <add key="DbField" value="" />
  </appSettings>
</configuration>
